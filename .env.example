# =============================================================================
# Medicus configuration. Copy to `.env` and fill in the values marked REQUIRED.
# Every variable is documented in docs/configuration.md.
# Comments must be on their own line (no trailing comments after values).
# =============================================================================

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Product name used in emails and logs
APP_NAME=Medicus
# Comma-separated origins allowed to call the APIs from a browser (web clients)
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Host port of the API gateway (change if 8080 is taken by another web server)
GATEWAY_PORT=8080

# ----------------------------------------------------------------------------
# Secrets (REQUIRED). Generate each with:  openssl rand -hex 32
# The services refuse to start while these still contain CHANGE_ME.
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
INTERNAL_API_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ----------------------------------------------------------------------------
# PostgreSQL. docker compose points POSTGRES_HOST/PORT at the bundled database.
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medicus
POSTGRES_USER=medicus
# REQUIRED, at least 8 characters
POSTGRES_PASSWORD=CHANGE_ME_strong_password
# disable | prefer | require | verify-full (use verify-full for managed databases)
POSTGRES_SSL_MODE=prefer

# ----------------------------------------------------------------------------
# Language models (REQUIRED: pick one provider). See docs/llm-providers.md.
# ----------------------------------------------------------------------------
# A) OpenAI (default). Unset LLM_MODEL_* roles use MedicusCommon/medicus_common/core/config.json.
LLM_PROVIDER=openai
LLM_API_KEY=

# B) Any OpenAI-compatible server: Ollama, vLLM, LM Studio, llama.cpp, LocalAI,
#    OpenRouter, Groq, Together, Azure OpenAI (v1 endpoint)...
#    Ollama in the stack (docker compose --profile ollama):  http://ollama:11434/v1
#    Ollama installed on the host machine:                  http://host.docker.internal:11434/v1
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:14b

# C) LiteLLM: Anthropic, Gemini, Bedrock, Mistral... (build with AI_COMMON_EXTRAS=ai,litellm)
# LLM_PROVIDER=litellm
# LLM_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Optional per-role models ("tools" is the main assistant and must support tool calling):
# LLM_MODEL_TOOLS=
# LLM_MODEL_TEXT=
# LLM_MODEL_SUMMARY=
# LLM_MODEL_GUARDRAIL=
# LLM_MODEL_TRIAGE=
# LLM_MODEL_VISION=
# LLM_MODEL_LAB=
# LLM_MODEL_DOC=
# Reasoning/thinking effort: none | minimal | low | medium | high.
# OpenAI reasoning models default to low. For local thinking models (Qwen3, DeepSeek-R1,
# gpt-oss on Ollama/vLLM) set none: hidden reasoning otherwise eats the output budget.
# LLM_REASONING_EFFORT=low
# Set to false if your model cannot read images:
# LLM_SUPPORTS_VISION=true
# Small local models: require a tool call before answering, so records are looked up
# instead of invented (recommended for models under ~30B parameters):
# LLM_FORCE_TOOL_USE=true
# Prompt-injection classifier on every user turn:
# LLM_GUARDRAIL_ENABLED=true

# Speech-to-text for voice notes. Defaults to OpenAI when LLM_PROVIDER=openai, otherwise
# disabled. Any server implementing /v1/audio/transcriptions works.
# STT_PROVIDER=openai_compatible
# STT_BASE_URL=http://whisper:8000/v1
# STT_MODEL=Systran/faster-whisper-small
# Or reuse Ollama (needs a recent Ollama with /v1/audio/transcriptions, e.g. 0.40.15):
# STT_BASE_URL=http://host.docker.internal:11434/v1
# STT_MODEL=lfm3-audio            # or lfm3-omni

# Text-to-speech for live voice conversations, same rules (e.g. Kokoro-FastAPI, LocalAI).
# TTS_PROVIDER=openai_compatible
# TTS_BASE_URL=http://kokoro:8880/v1
# TTS_MODEL=kokoro
# TTS_VOICE=af_bella
# TTS_FORMAT=wav                   # audio format requested from the server
# Or one Ollama audio model for both directions:
# TTS_BASE_URL=http://host.docker.internal:11434/v1
# TTS_MODEL=lfm3-omni
# TTS_VOICE=female-american-english

# Live voice conversations ("Talk to Sara") need STT_* and TTS_* above. The assistant can run
# on its own, smaller model so a reply starts within seconds; it must support tool calling.
# With Ollama, also set OLLAMA_MAX_LOADED_MODELS=2 so it stays loaded next to the speech model.
# LLM_MODEL_VOICE=qwen3.5:4b

# MediKnowledge (doctors' published material) searches with PostgreSQL full-text search.
# Add an embedding model to also match by meaning. Any /v1/embeddings server works;
# defaults to LLM_BASE_URL and LLM_API_KEY.
# EMBEDDING_MODEL=nomic-embed-text        # e.g. `ollama pull nomic-embed-text`
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# Optional Elasticsearch ingestion pipeline (MedicusAI/src/tools/mediknowledge/ingestion):
# start it with `docker compose --profile elasticsearch up -d elasticsearch`.
# ELASTICSEARCH_URL=http://elasticsearch:9200
# EMBEDDING_DIMENSION=768                 # must match EMBEDDING_MODEL
# KNOWLEDGE_BUCKET_ROOT=                  # default STORAGE_LOCAL_PATH/knowledge

# ----------------------------------------------------------------------------
# File storage (attachments, voice notes, document vault)
# ----------------------------------------------------------------------------
# local | s3 | azure
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
# Bucket (s3) or container (azure)
STORAGE_BUCKET=medicus
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AZURE_STORAGE_CONNECTION_STRING=

# ----------------------------------------------------------------------------
# Email (verification codes, password reset, notifications)
# ----------------------------------------------------------------------------
# smtp | azure | console (development only) | none
EMAIL_BACKEND=smtp
EMAIL_FROM=Medicus <no-reply@localhost>
# Defaults target the bundled Mailpit catcher (UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
# starttls | ssl | none
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# Push notifications
# ----------------------------------------------------------------------------
# Only needed if you enabled "enhanced security" for Expo push
EXPO_ACCESS_TOKEN=
# Optional Firebase Cloud Messaging service-account file
# FCM_CREDENTIALS_PATH=/run/secrets/firebase.json

# ----------------------------------------------------------------------------
# Authentication hardening
# ----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Attempts allowed per AUTH_RATE_WINDOW_SECONDS, per client IP and endpoint
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

# ----------------------------------------------------------------------------
# Optional integrations
# ----------------------------------------------------------------------------
# SENTRY_DSN=
# LOG_FORMAT=json
# LOG_HTTP_ENDPOINT=logstash:8080
# Enables the evaluation API used by the separate MediBench project:
# MEDIBENCH_API_KEY=
