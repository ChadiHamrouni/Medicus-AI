# Normalize line endings: LF in the repository and in working copies, so shell
# scripts and Dockerfiles work inside Linux containers on every OS.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
