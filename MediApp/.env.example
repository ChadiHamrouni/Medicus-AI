# MediApp configuration. Copy to .env.local (git-ignored) and adjust.
# All values are read in ONE place: utils/infrastructure/env.ts. The app contains no hard-coded
# server address or website: change these values, not the code.
# EAS builds read the same names from EAS environment variables (see README > Running the mobile app).
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and visible to users:
# never put secrets (LLM keys, internal API keys) here.

# --- Backend --------------------------------------------------------------
# Base URL of the API gateway (docker compose exposes it on :8080).
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.20:8080
# Android emulator: http://10.0.2.2:8080
EXPO_PUBLIC_MEDICUS_API_BASE_URL=http://localhost:8080

# Optional per-service overrides (default: <base>/api/<Service>)
# EXPO_PUBLIC_MEDICUS_USER_API_BASE_URL=
# EXPO_PUBLIC_MEDICUS_CONVO_API_BASE_URL=
# EXPO_PUBLIC_MEDICUS_AI_API_BASE_URL=
# EXPO_PUBLIC_MEDICUS_NOTIFICATION_API_URL=
# EXPO_PUBLIC_SOCKETIO_URL=

# --- Public links (optional: the matching entry is hidden when unset) ----
# EXPO_PUBLIC_WEBSITE_URL=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_SUPPORT_EMAIL=
# EXPO_PUBLIC_APP_STORE_URL=
# EXPO_PUBLIC_PLAY_STORE_URL=

# --- Optional integrations -----------------------------------------------
# Google Maps key for the doctor map (restrict it to your bundle id in GCP).
# GOOGLE_MAPS_API_KEY=
# Crash reporting
# EXPO_PUBLIC_SENTRY_DSN=

# --- EAS builds / OTA updates (only if you publish your own build) -------
# EXPO_OWNER=
# EAS_PROJECT_ID=
# APP_BUNDLE_ID=org.medicus.app

# Development only: skip route guards for UI work (ignored in release builds)
# EXPO_PUBLIC_ENABLE_DEV_BYPASS=false
