{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SKIP_POSTINSTALL": "true",
        "RCT_NEW_ARCH_ENABLED": "1"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
