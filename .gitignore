# =============================================================================
# Medicus monorepo .gitignore
# =============================================================================

# --- Secrets & local configuration (never commit) ----------------------------
.env
.env.*
!.env.example
*.local
.netrc
*.pem
*.key
*.crt
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
ssl/
firebase-credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist

# --- AI coding-assistant files -------------------------------------------------
CLAUDE.md
CLAUDE.local.md
.claude/
.codeviz/
.cursor/
.aider*
.copilot/

# --- Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
# Virtual environments (any name used in this repo's history)
.venv/
venv/
env/
openai_env/
pyvenv.cfg
CACHEDIR.TAG
/MedicusAI/MedicusAILatest/
/MedicusAILatest/MedicusAILatest/
/MedicusConvo/MedicusConvo/
# The repository root doubles as a local virtualenv (Lib/, Include/, Scripts/).
# On Windows "Scripts" and "scripts" are the same folder, so ignore its contents
# and re-include only the project's own scripts.
/Lib/
/Include/
/include/
/Scripts/*
!/Scripts/smoke_test.py
!/Scripts/e2e.sh
/share/
# Any other virtualenv content, wherever it lives
**/site-packages/
**/Lib/site-packages/
**/Scripts/python*.exe
**/Scripts/pip*.exe
**/Scripts/activate*
**/Scripts/deactivate.bat
# --- Logs & tool output ---------------------------------------------------------
logs/
*.log
pylint_errors.txt
tsc_output.log
npm-debug.*
yarn-debug.*
yarn-error.*

# --- React Native / Expo (apps/mobile, MediApp) ---------------------------------
node_modules/
.expo/
web-build/
expo-env.d.ts
.kotlin/
*.tsbuildinfo
.metro-health-check*
*.orig.*
# Native projects are generated by `npx expo prebuild` (Continuous Native Generation)
/MediApp/android/
/MediApp/ios/
/apps/mobile/android/
/apps/mobile/ios/

# --- Local runtime data ---------------------------------------------------------
/data/

# --- Editors & OS -------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
.VSCodeCounter/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Not part of this repository ------------------------------------------------
/MediBench/
/MediWeb/
/Context/
docker-compose.legacy.yml

# Legacy per-service test suites: bound to a private database and contain
# credentials. Superseded by tests/e2e and scripts/smoke_test.py.
/MedicusUser/tests/
/MedicusConvo/tests/
/MedicusAI/tests/
/MedicusAI/conftest.py
/MedicusAILatest/tests/
/MedicusAILatest/conftest.py

# Internal design notes from the pre-open-source (Azure) architecture; superseded by README.md/docs
/MedicusConvo/docs/
# Archived prompt snapshots
/MedicusAI/src/assistants/version_control/

# Maestro UI-test run output
/MediApp/tests/.maestro/screenshots/
